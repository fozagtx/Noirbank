# Noirbank defaults to the public Zcash testnet and zecrocks lightwalletd.
# These settings are optional overrides; the app runs without this file.
# Keep wallet data and age identities out of this file and source control.
# NOIRBANK_DEVTOOL_BIN=/absolute/path/to/zcash-devtool
# NOIRBANK_VAULT_DIR=/absolute/path/to/data/vault
# NOIRBANK_LIGHTWALLETD_SERVER=zecrocks
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
